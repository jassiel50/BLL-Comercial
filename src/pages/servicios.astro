---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_URL } from '../data/site';

const especialidades = [
  'Instalaciones eléctricas industriales', 'Instalaciones mecánicas', 'Sistemas neumáticos', 'Sistemas hidráulicos',
  'Programación y automatización', 'Mantenimiento preventivo y correctivo', 'Instalación y puesta en marcha', 'Integración y modificación de control',
];

const services = [
  {
    id: 'electrica',
    title: 'Soluciones eléctricas',
    body: 'Instalación, conexión, modificación e integración de sistemas eléctricos industriales.',
    img: '/images/servicios/electrica-a.jpg',
    tags: ['Tableros eléctricos y de control', 'Cableado de fuerza y control', 'Sensores y dispositivos', 'Motores y variadores de frecuencia', 'Sistemas de control', 'Conexiones de maquinaria', 'Diagnóstico y corrección de fallas'],
  },
  {
    id: 'mecanica',
    title: 'Soluciones mecánicas',
    body: 'Montaje, modificación y mantenimiento de maquinaria e infraestructura mecánica.',
    img: '/images/servicios/mecanica-a.jpg',
    tags: ['Montaje e instalación de maquinaria', 'Modificación y fabricación de componentes', 'Alineación y ajustes', 'Mantenimiento mecánico'],
  },
  {
    id: 'hidraulica',
    title: 'Soluciones hidráulicas',
    body: 'Instalación, conexión y diagnóstico de sistemas hidráulicos industriales.',
    img: '/images/servicios/soldadura-b.jpg',
    tags: ['Instalación y conexión de sistemas', 'Unidades hidráulicas', 'Tuberías y componentes', 'Diagnóstico de fallas'],
  },
  {
    id: 'neumatica',
    title: 'Soluciones neumáticas',
    body: 'Instalación y mantenimiento de líneas, válvulas y sistemas de control neumático.',
    img: '/images/servicios/pintura-b.jpg',
    tags: ['Instalación de líneas y componentes', 'Válvulas y sistemas de control', 'Mantenimiento y corrección de fugas'],
  },
  {
    id: 'automatizacion',
    title: 'Automatización y programación',
    body: 'Tecnología aplicada para mejorar operación, productividad, seguridad y confiabilidad.',
    img: '/images/servicios/arranque-a.jpg',
    tags: ['Programación de PLC', 'Configuración de sistemas de control', 'Variadores de frecuencia', 'Sensores y actuadores', 'Modificación de secuencias', 'Diagnóstico de sistemas automatizados', 'Integración de equipos', 'Puesta en marcha'],
  },
  {
    id: 'mantenimiento',
    title: 'Mantenimiento y servicio industrial',
    body: 'Soporte técnico para mantener la continuidad operativa de tu planta.',
    img: '/images/servicios/mecanica-b.jpg',
    tags: ['Mantenimiento preventivo', 'Mantenimiento correctivo', 'Diagnóstico de fallas', 'Reparaciones', 'Modificaciones y mejoras', 'Reacondicionamiento de maquinaria', 'Puesta en operación', 'Pruebas de funcionamiento'],
  },
];

const steps = [
  { n: '01', title: 'Ingeniería', body: 'Levantamiento en sitio e ingeniería de detalle para definir el alcance técnico real del proyecto.' },
  { n: '02', title: 'Ejecución', body: 'Ejecutamos la obra en fases verificables, apegadas a protocolos de seguridad y tolerancias técnicas.' },
  { n: '03', title: 'Integración', body: 'Integramos las disciplinas eléctrica, mecánica, hidráulica, neumática y de automatización en un mismo equipo.' },
  { n: '04', title: 'Pruebas', body: 'Pruebas funcionales y diagnóstico antes de la entrega, con revisión conjunta con el cliente.' },
  { n: '05', title: 'Puesta en marcha', body: 'Acompañamiento hasta la puesta en marcha y soporte técnico posterior a la entrega.' },
];
---
<Layout title="Servicios técnicos — BLL Servicios y Proyectos Industriales">
  <main style="max-width: 1400px; margin: 0 auto; padding: 0 clamp(28px,6vw,64px)">
    <section class="stack-mobile" style="padding: 32px 0 24px; display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); gap: 40px; align-items: center">
      <div>
        <span class="card-kicker" style="display: block; margin-bottom: 16px">Nuestras especialidades</span>
        <h1 style="font-size: clamp(28px,4.2vw,42px); margin: 0; max-width: 20ch">Integración de disciplinas para resolver necesidades industriales.</h1>
        <p style="font-size: 16px; line-height: 1.7; color: var(--color-neutral-700); max-width: 56ch; margin: 20px 0 0">Eléctrico + mecánico + hidráulico + neumático + automatización, coordinados por un solo equipo, desde la ingeniería hasta la puesta en marcha.</p>
        <div class="marquee" style="margin-top: 22px">
          <div class="marquee-track">
            {[...especialidades, ...especialidades].map((c) => (
              <span style="display: inline-flex; align-items: center; flex: none; font-size: 12px; font-weight: 600; color: var(--color-primary-600); background: var(--color-surface-low); padding: 8px 14px; border-radius: 999px">{c}</span>
            ))}
          </div>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-accent" style="margin-top: 24px">Solicitar consulta técnica</a>
      </div>
      <div style="position: relative; width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md)">
        <img src="/images/real/linea-produccion-1.jpg" alt="Línea de producción industrial" class="img-cover" />
        <div class="float-slow" style="position: absolute; top: 14px; left: 14px; display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 600; color: var(--color-primary-600); background: color-mix(in srgb, #fff 88%, transparent); backdrop-filter: blur(10px); border-radius: 999px; padding: 7px 13px">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); flex: none; animation: waPulse 2s ease-in-out infinite"></span>
          Eléctrico · Mecánico · Automatización
        </div>
      </div>
    </section>

    <section data-reveal="1" style="padding: 40px 0 64px">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px,100%),1fr)); gap: 20px">
        {services.map((s) => (
          <div id={s.id} class="card hover-lift" style="padding: 0; overflow: hidden; scroll-margin-top: 96px">
            <div style="position: relative; width: 100%; aspect-ratio: 16/11; overflow: hidden">
              <img src={s.img} alt={s.title} class="img-cover" />
            </div>
            <div style="padding: 22px">
              <h2 class="card-title">{s.title}</h2>
              <p class="card-body" style="margin-top: 6px">{s.body}</p>
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--color-divider)">
                {s.tags.map((t) => (
                  <span class="tag tag-neutral">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section data-reveal="1" style="padding: 40px 0 64px; border-top: 1px solid var(--color-divider)">
      <span class="card-kicker" style="display: block; margin-bottom: 14px">Proyectos integrales</span>
      <h2 style="font-size: clamp(22px,2.6vw,28px); margin: 0 0 8px">Una sola coordinación para múltiples especialidades.</h2>
      <p style="font-size: 15.5px; color: var(--color-neutral-700); margin: 0 0 32px; max-width: 62ch">Integramos diferentes disciplinas en un mismo proyecto para facilitar la ejecución, reducir tiempos de coordinación y acompañar al cliente hasta la puesta en marcha.</p>
      <div style="display: flex; flex-direction: column">
        {steps.map((step) => (
          <div style="display: grid; grid-template-columns: 56px minmax(0,1fr); gap: 20px; padding: 20px 0; border-top: 1px solid var(--color-divider)">
            <span style="font-family: var(--font-heading); font-weight: 800; font-size: 16px; color: var(--color-accent-600)">{step.n}</span>
            <div>
              <h3 style="font-size: 19px; margin: 0 0 6px">{step.title}</h3>
              <p style="font-size: 15.5px; line-height: 1.6; color: var(--color-neutral-700); margin: 0; max-width: 54ch">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="padding: 0 0 96px">
      <div class="card" style="flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px">
        <p style="margin: 0; font-size: 15px; color: var(--color-neutral-700); max-width: 42ch">¿Tienes una obra o instalación en mente? Conversemos sin compromiso.</p>
        <a href="/contacto" class="btn btn-primary" style="white-space: nowrap">Hablemos</a>
      </div>
    </section>
  </main>
</Layout>
