---
import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import LogoMark from '../components/LogoMark.astro';
import { WHATSAPP_URL, WHATSAPP_DISPLAY, CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_ADDRESS, WECHAT_CONTACT_NAME, WECHAT_QR_IMAGE } from '../data/site';
---
<Layout title="Contacto — BLL Servicios y Proyectos Industriales">
  <main>
    <section style="background: var(--color-bg)">
     <div class="wrap" style="padding-block: 36px 40px">
      <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: var(--color-primary-600); background: var(--color-primary-100); padding: 7px 14px; border-radius: 999px; margin-bottom: 24px">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); flex: none"></span>
        Disponibilidad para nuevos proyectos
      </span>
      <h1 style="font-size: clamp(28px,4.4vw,44px); margin: 0; max-width: 18ch">Hablemos de tu próxima obra.</h1>
      <p style="font-size: 16px; line-height: 1.7; color: var(--color-neutral-700); max-width: 54ch; margin: 20px 0 0">Cuéntanos el alcance mecánico o eléctrico de tu proyecto y te ayudamos a definir el mejor camino técnico para ejecutarlo.</p>
     </div>
    </section>

    <section style="background: var(--color-surface)">
     <div class="stack-mobile wrap" style="padding-block: 40px 96px; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); gap: 40px; align-items: start">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="card contact-card" style="flex-direction: row; align-items: center; gap: 16px; text-decoration: none; color: inherit">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: var(--color-primary-100); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600)">
            <WhatsAppIcon size={22} />
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">WhatsApp directo</h2>
            <p style="font-size: 15.5px; font-weight: 600; margin: 0">{WHATSAPP_DISPLAY}</p>
          </div>
          <span class="contact-arrow" style="color: var(--color-accent-600); transition: transform 0.2s ease">→</span>
        </a>
        <div class="card" style="flex-direction: row; align-items: center; gap: 16px">
          <img src={WECHAT_QR_IMAGE} alt="Código QR de WeChat" width="64" height="64" style="flex: none; border-radius: var(--radius-sm)" />
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">WeChat</h2>
            <p style="font-size: 15.5px; font-weight: 600; margin: 0">Escanea para agregarnos</p>
            <p style="font-size: 13px; color: var(--color-neutral-600); margin: 2px 0 0">{WECHAT_CONTACT_NAME}</p>
          </div>
        </div>
        <a href={`mailto:${CONTACT_EMAIL}`} class="card contact-card" style="flex-direction: row; align-items: center; gap: 16px; text-decoration: none; color: inherit">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: var(--color-primary-100); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600)">
            <svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-96,85.15L52.57,64H203.43ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12.63,11.51a8,8,0,0,0,10.64,0l12.63-11.51L207.43,192H48.57ZM157.29,128,216,74.18V181.82Z"></path></svg>
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">Correo</h2>
            <p style="font-size: 15.5px; font-weight: 600; margin: 0; overflow-wrap: anywhere">{CONTACT_EMAIL}</p>
          </div>
          <span class="contact-arrow" style="color: var(--color-accent-600); transition: transform 0.2s ease">→</span>
        </a>
        <div class="card" style="flex-direction: row; align-items: center; gap: 16px">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: var(--color-primary-100); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600)">
            <svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.24.39-.49.57-.75a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">Teléfono</h2>
            <p style="font-size: 15.5px; font-weight: 600; margin: 0">{CONTACT_PHONE_DISPLAY}</p>
          </div>
        </div>
        <div class="card" style="flex-direction: row; align-items: center; gap: 16px">
          <div style="width: 44px; height: 44px; flex: none; border-radius: var(--radius-sm); background: var(--color-primary-100); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600)">
            <svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M128,16a88.1,88.1,0,0,0-88,88c0,75.3,80,132.17,83.41,134.55a8,8,0,0,0,9.18,0C136,236.17,216,179.3,216,104A88.1,88.1,0,0,0,128,16Zm0,120a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z"/></svg>
          </div>
          <div style="flex: 1; min-width: 0">
            <h2 class="card-kicker" style="margin-bottom: 4px">Ubicación</h2>
            <p style="font-size: 15.5px; font-weight: 600; margin: 0">{CONTACT_ADDRESS}</p>
          </div>
        </div>
        <div style="position: relative; width: 100%; aspect-ratio: 16/10; border-radius: var(--radius-lg); overflow: hidden; margin-top: 8px">
          <img src="/images/proyectos/planta-interior.jpg" alt="Planta de BLL Servicios y Proyectos Industriales" class="img-cover" />
        </div>
      </div>

      <div>
      <div class="card" style="padding: 32px">
        <h2 style="font-size: 20px; margin: 0 0 24px">Cuéntanos sobre tu proyecto</h2>
        <form id="contact-form" style="display: flex; flex-direction: column; gap: 18px">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(160px,100%),1fr)); gap: 16px">
            <div class="field">
              <label for="name">Nombre</label>
              <input id="name" name="name" class="input" type="text" required placeholder="Tu nombre" />
            </div>
            <div class="field">
              <label for="company">Empresa</label>
              <input id="company" name="company" class="input" type="text" placeholder="Opcional" />
            </div>
          </div>
          <div class="field">
            <label for="email">Correo</label>
            <input id="email" name="email" class="input" type="email" required placeholder="correo@empresa.com" />
          </div>
          <div class="field">
            <label for="message">Descripción del proyecto</label>
            <textarea id="message" name="message" class="input" required placeholder="Qué obra o instalación necesitas resolver…" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self: flex-start">Enviar propuesta →</button>
          <p id="contact-sent" hidden style="font-size: 12.5px; color: var(--color-neutral-600); margin: 0">Se abrió tu cliente de correo con la propuesta. Si no ocurre, escribe directamente a {CONTACT_EMAIL}.</p>
        </form>
      </div>
      <div style="display: flex; justify-content: center; padding-top: 20px">
        <LogoMark height={36} opacity={0.5} />
      </div>
      </div>
     </div>
    </section>
  </main>

  <style>
    .contact-card:hover {
      box-shadow: 0 0 0 1px var(--color-primary-600);
    }
    .contact-card:hover .contact-arrow {
      transform: translateX(4px);
    }
  </style>

  <script define:vars={{ CONTACT_EMAIL }}>
    const form = document.getElementById('contact-form');
    const sentMsg = document.getElementById('contact-sent');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = data.get('name') || '';
      const company = data.get('company') || '';
      const email = data.get('email') || '';
      const message = data.get('message') || '';

      const subject = encodeURIComponent(`Consulta de proyecto — ${name || 'Nuevo contacto'}`);
      const body = encodeURIComponent(
        `Nombre: ${name}\nEmpresa: ${company || '—'}\nCorreo: ${email}\n\n${message}`
      );
      window.location.href = `mailto:${CONTACT_EMAIL}?subject=${subject}&body=${body}`;
      if (sentMsg) sentMsg.hidden = false;
    });
  </script>
</Layout>
