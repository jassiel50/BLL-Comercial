---
import Layout from '../layouts/Layout.astro';
import StatBar from '../components/StatBar.astro';

const values = [
  {
    title: 'Seguridad primero',
    body: 'Cada fase de obra sigue protocolos de seguridad estrictos, sin importar la presión de tiempos.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M208,40H48A16,16,0,0,0,32,56v58.78c0,80.36,75.8,113.28,91.36,119.4a15.94,15.94,0,0,0,9.28,0C148.2,228.06,224,195.14,224,114.78V56A16,16,0,0,0,208,40Zm-33.66,74.34-56,56a8,8,0,0,1-11.31,0l-24-24a8,8,0,1,1,11.31-11.31L112,152.69l50.34-50.35a8,8,0,1,1,11.32,11.32Z"/></svg>',
  },
  {
    title: 'Precisión técnica',
    body: 'Ingeniería de detalle y tolerancias estrictas en cada instalación mecánica y eléctrica.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M226.53,56.41a8,8,0,0,0-9-1.41l-40,20a8,8,0,0,0-4.41,7.14v33.72L104,148.56V88a8,8,0,0,0-4.41-7.14l-64-32a8,8,0,0,0-11.18,10.7L32,66.94v122.1l-7.59,3.8a8,8,0,0,0,3.18,15.32,7.9,7.9,0,0,0,3.58-.86l64-32A8,8,0,0,0,100,168V107.44l69.12-34.56L232,105.06,169.12,136.5l-8.53-4.27a8,8,0,0,0-7.16,14.31l64,32A8,8,0,0,0,224,176V85.72l7.59-3.8A8,8,0,0,0,226.53,56.41Z"/></svg>',
  },
  {
    title: 'Cumplimiento normativo',
    body: 'Procesos alineados a estándares industriales, con documentación técnica clara para cada entrega.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M225.86,102.82c-3.77-3.94-7.67-8-9.14-11.57-1.36-3.27-1.44-8.69-1.52-13.94-.15-9.76-.31-20.82-8-28.51s-18.75-7.85-28.51-8c-5.25-.08-10.67-.16-13.94-1.52-3.56-1.47-7.63-5.37-11.57-9.14C146.28,23.51,138.44,16,128,16s-18.27,7.51-25.18,14.14c-3.94,3.77-8,7.67-11.57,9.14C88,40.64,82.56,40.72,77.31,40.8c-9.76.15-20.82.31-28.51,8S41,67.55,40.8,77.31c-.08,5.25-.16,10.67-1.52,13.94-1.47,3.56-5.37,7.63-9.14,11.57C23.51,109.72,16,117.56,16,128s7.51,18.27,14.14,25.18c3.77,3.94,7.67,8,9.14,11.57,1.36,3.27,1.44,8.69,1.52,13.94.15,9.76.31,20.82,8,28.51s18.75,7.85,28.51,8c5.25.08,10.67.16,13.94,1.52,3.56,1.47,7.63,5.37,11.57,9.14C109.72,232.49,117.56,240,128,240s18.27-7.51,25.18-14.14c3.94-3.77,8-7.67,11.57-9.14,3.27-1.36,8.69-1.44,13.94-1.52,9.76-.15,20.82-.31,28.51-8s7.85-18.75,8-28.51c.08-5.25.16-10.67,1.52-13.94,1.47-3.56,5.37-7.63,9.14-11.57C232.49,146.28,240,138.44,240,128S232.49,109.73,225.86,102.82Zm-52.2,6.84-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.68l50.34-50.34a8,8,0,0,1,11.32,11.32Z"/></svg>',
  },
  {
    title: 'Compromiso con el cliente',
    body: 'Acompañamos cada proyecto de principio a fin, con comunicación clara en cada fase de obra.',
    icon: '<svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor"><path d="M117.25,157.92a60,60,0,1,0-66.5,0A95.83,95.83,0,0,0,3.53,195.63a8,8,0,1,0,13.4,8.74,80,80,0,0,1,134.14,0,8,8,0,0,0,13.4-8.74A95.83,95.83,0,0,0,117.25,157.92ZM40,108a44,44,0,1,1,44,44A44.05,44.05,0,0,1,40,108Zm210.14,98.7a8,8,0,0,1-11.07-2.33A79.83,79.83,0,0,0,172.72,170a8,8,0,0,1,3.4-15.72,60,60,0,0,0,29-113.85,8,8,0,0,1,4.24-15.42,76,76,0,0,1,53.29,140.1,95.86,95.86,0,0,1,46.68,37.57A8,8,0,0,1,250.14,206.7Z"/></svg>',
  },
];
---
<Layout title="Nosotros — BLL Servicios y Proyectos Industriales" footerVariant="full">
  <main>
    <section class="stack-mobile wrap" style="padding: 40px 0 24px; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); gap: 40px; align-items: center">
      <div>
        <span class="card-kicker" style="display: block; margin-bottom: 16px">Quiénes somos</span>
        <h1 style="font-size: clamp(28px,4.2vw,42px); margin: 0; max-width: 18ch">Ingeniería industrial con enfoque de ejecución.</h1>
        <p style="font-size: 16px; line-height: 1.7; color: var(--color-neutral-700); max-width: 54ch; margin: 20px 0 0">
          BLL Servicios y Proyectos Industriales integra ingeniería mecánica, eléctrica y de control bajo un mismo
          equipo, para llevar proyectos de infraestructura industrial desde el diseño hasta la puesta en marcha —
          con la seguridad y precisión técnica que exige la operación continua de una planta.
        </p>
      </div>
      <div style="position: relative; width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md)">
        <img src="/images/proyectos/planta-interior.jpg" alt="Interior de planta industrial" class="img-cover" />
      </div>
    </section>

    <section style="background: var(--color-surface)">
      <div data-reveal="1" class="wrap" style="padding-block: 48px">
        <StatBar />
      </div>
    </section>

    <section style="background: var(--color-bg)">
      <div data-reveal="1" class="wrap" style="padding-block: 64px">
        <span class="card-kicker" style="display: block; margin-bottom: 14px">Nuestros principios</span>
        <h2 style="font-size: clamp(22px,2.8vw,30px); margin: 0 0 36px; max-width: 30ch">Lo que guía cada proyecto que ejecutamos.</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 28px">
          {values.map((v) => (
            <div>
              <div style="width: 46px; height: 46px; border-radius: var(--radius-sm); background: var(--color-primary-100); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); margin-bottom: 16px" set:html={v.icon} />
              <h3 style="font-size: 18px; margin: 0 0 8px">{v.title}</h3>
              <p style="font-size: 15px; line-height: 1.6; color: var(--color-neutral-700); margin: 0; max-width: 34ch">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section data-reveal="1" style="background: var(--color-bg)">
      <div class="wrap" style="padding-block: 0 64px">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px,100%),1fr)); gap: 18px">
          <div style="position: relative; aspect-ratio: 4/3; border-radius: var(--radius-md); overflow: hidden; grid-column: span 2">
            <img src="/images/proyectos/linea-roladora.jpg" alt="Equipo trabajando en línea de fabricación" class="img-cover" />
          </div>
          <div style="position: relative; aspect-ratio: 4/3; border-radius: var(--radius-md); overflow: hidden">
            <img src="/images/proyectos/electrico-tablero-principal.jpg" alt="Instalación eléctrica industrial" class="img-cover" />
          </div>
        </div>
      </div>
    </section>

  </main>
  <Fragment slot="footer-cta">
    <h2 style="color: #fff; font-size: clamp(22px,2.6vw,28px); margin: 0; max-width: 26ch">¿Quieres conocer más sobre nuestra capacidad instalada?</h2>
    <p style="font-size: 16px; color: color-mix(in srgb, #fff 78%, transparent); margin: 0; max-width: 48ch">Revisa nuestra galería de proyectos o cuéntanos directamente qué necesitas resolver.</p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap">
      <a href="/proyectos" class="btn btn-accent" style="margin-top: 8px">Ver proyectos</a>
      <a href="/contacto" class="btn btn-secondary" style="margin-top: 8px">Contactar</a>
    </div>
  </Fragment>
</Layout>
