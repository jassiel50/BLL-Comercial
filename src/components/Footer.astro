---
import LogoMark from './LogoMark.astro';
import { COMPANY_NAME, WHATSAPP_URL, CONTACT_EMAIL } from '../data/site';

interface Props {
  variant?: 'full' | 'simple';
}
const { variant = 'simple' } = Astro.props;

const linkColumns = [
  {
    title: 'Empresa',
    links: [
      { label: 'Servicios', href: '/servicios' },
      { label: 'Proyectos', href: '/proyectos' },
      { label: 'Nosotros', href: '/nosotros' },
    ],
  },
  {
    title: 'Recursos',
    links: [
      { label: 'Certificaciones', href: '#' },
      { label: 'Ubicaciones', href: '#' },
      { label: 'Protocolos de seguridad', href: '#' },
      { label: 'Vacantes', href: '#' },
      { label: 'Aviso de privacidad', href: '#' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer style="background: var(--color-primary-700); color: #fff">
  {variant === 'full' && (
    <div data-reveal="1" class="wrap" style="padding-block: 64px 40px; display: grid; grid-template-columns: minmax(0,1.2fr) repeat(2, minmax(0,1fr)); gap: 40px">
      <div>
        <LogoMark height={32} />
        <p style="font-size: 15px; line-height: 1.7; color: color-mix(in srgb, #fff 70%, transparent); margin: 16px 0 0; max-width: 40ch">
          {COMPANY_NAME}. Ingeniería mecánica, eléctrica y de control para plantas e infraestructura industrial.
        </p>
        <div style="display: flex; gap: 10px; margin-top: 20px">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn btn-accent">Escríbenos por WhatsApp</a>
        </div>
      </div>
      {linkColumns.map((col) => (
        <div>
          <h6 style="color: color-mix(in srgb, #fff 55%, transparent); margin-bottom: 16px">{col.title}</h6>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px">
            {col.links.map((l) => (
              <li><a href={l.href} style="color: color-mix(in srgb, #fff 85%, transparent); text-decoration: none; font-size: 14.5px">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
  <div class="wrap" style="padding-block: 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid color-mix(in srgb, #fff 12%, transparent)">
    {variant === 'simple' && (
      <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 10px">
        <LogoMark height={24} />
      </a>
    )}
    <p style="margin: 0; font-size: 12.5px; color: color-mix(in srgb, #fff 55%, transparent)">
      © {year} {COMPANY_NAME}. Todos los derechos reservados.
    </p>
    {variant === 'simple' && (
      <a href={`mailto:${CONTACT_EMAIL}`} style="color: color-mix(in srgb, #fff 70%, transparent); text-decoration: none; font-size: 12.5px">{CONTACT_EMAIL}</a>
    )}
  </div>
</footer>
